{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [{ "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }] }],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://medicontrol-sv.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
